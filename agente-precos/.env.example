# Copie para .env (que é ignorado pelo git) e preencha SOMENTE o que for usar.
# Nenhuma chave é obrigatória: sem elas o agente funciona com URLs fornecidas
# pelo usuário / pela sessão do Claude Code (WebSearch) e verifica cada página.

# Descoberta automática de ofertas (opcional, qualquer um dos dois):
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Identificação do robô nas requisições (não finja ser um navegador):
PRECOS_USER_AGENT=agente-precos/0.1 (pesquisa de precos pessoal; respeita robots.txt)

# Onde guardar banco SQLite e cache (padrão: ./data)
PRECOS_DATA_DIR=

# Avisos do monitor de preço-alvo (opcionais; só são usados com `monitor check --notificar`):
# ntfy (app grátis; o NOME do tópico funciona como senha: use algo longo e aleatório, ex.: precos-9f3k2x7q1m8d4z)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
# Webhook genérico (recebe JSON {"origem","titulo","mensagem"}):
ALERT_WEBHOOK_URL=
# Telegram (crie o bot com @BotFather e descubra o chat id; nunca compartilhe o token):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
